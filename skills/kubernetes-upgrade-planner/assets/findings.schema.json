{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kubernetes-upgrade-planner findings",
  "type": "object",
  "required": [
    "meta",
    "components",
    "matrix"
  ],
  "$defs": {
    "severity": {
      "enum": [
        "blocker",
        "required",
        "recommended",
        "ok"
      ]
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "date",
        "path"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "until"
            ]
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "footer": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title",
          "text"
        ],
        "properties": {
          "severity": {
            "$ref": "#/$defs/severity"
          }
        }
      }
    },
    "snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "values"
        ]
      }
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "minor"
        ],
        "properties": {
          "changelog": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "nodeLayer": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "problem",
          "action",
          "refs"
        ],
        "properties": {
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "refs": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "current",
          "refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "current": {
            "type": "object"
          },
          "targets": {
            "type": "object"
          },
          "refs": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "required": [
        "rows"
      ],
      "properties": {
        "hops": {
          "type": "array"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "steps",
              "refs"
            ],
            "properties": {
              "refs": {
                "$ref": "#/$defs/refs"
              },
              "cells": {
                "type": "object"
              },
              "why": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "final": {}
            }
          }
        }
      }
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "items"
        ]
      }
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "items"
        ]
      }
    }
  }
}
